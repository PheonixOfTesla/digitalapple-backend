PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digitalapple
JWT_SECRET=your-super-secret-jwt-key-change-this
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@digitalapple.co
FRONTEND_URL=https://theclockworkhub.com
ADMIN_SEED_PASSWORD=set-via-env-or-cli
ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# ── Barber booking platform (@handle) ────────────────────────────────────
# Payments and email reuse the Stripe + SMTP credentials above; barbers and the
# platform owner sign in with ordinary accounts (roles 'barber' and 'admin'),
# so there are no passcodes here.
BARBER_HANDLE=crispincuts
BARBER_EMAIL=barber@example.com
BARBER_TZ=America/New_York
# The platform's cut, in basis points. 300 = 3%. The application fee charged
# to each payment is this PLUS Stripe's own card fee, so the platform nets its
# rate rather than paying the card processor out of it.
BARBER_PLATFORM_FEE_BPS=300
# Stripe's published US card pricing, only for computing that split.
STRIPE_PCT_BPS=290
STRIPE_FIXED_CENTS=30
PUBLIC_API_URL=https://digitalapple-backend-production.up.railway.app
# Where the booking page is READ, if that is not this API's own host
# (the marketing site serves /@handle; this backend serves a copy too).
BOOKING_SITE_URL=https://www.theclockworkhub.com
BOOKING_ADMIN_URL=https://www.theclockworkhub.com/barber-admin
# Email goes out through Resend when this is set (the same key the other
# services on this account use); otherwise the SMTP block above; otherwise
# emails are logged and nothing else breaks.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=Crispin Cuts <bookings@yourverifieddomain.com>
